# Get your OpenAI API Key here for chat models: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=****

# Get your Anthropic API Key here: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=****

# Get your Fireworks AI API Key here for reasoning models: https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=****

# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on vercel

# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Local storage paths - Update these to your local project directory
STORAGE_DIR=/path/to/your/project/storage
EMBEDDINGS_DIR=/path/to/your/project/storage/embeddings
PROCESSED_DIR=/path/to/your/project/storage/processed
UPLOADS_DIR=/path/to/your/project/storage/uploads

# Instructions to create a database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
# For local development, use postgres://username:password@localhost:5432/database_name
POSTGRES_URL=****

# Get your Firecrawl API Key here: https://firecrawl.dev
FIRECRAWL_API_KEY=****

# Get your Speechmatics API Key here for audio transcription: https://app.speechmatics.com/login
SPEECHMATICS_API_KEY=****